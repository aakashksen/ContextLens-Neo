{
  "uid": "contextlens-overview",
  "title": "ContextLens",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Press latency p95 (s)",
      "datasource": {
        "type": "prometheus",
        "uid": "contextlens-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(contextlens_press_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "contextlens-prometheus"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Agent stage time p95 (s)",
      "datasource": {
        "type": "prometheus",
        "uid": "contextlens-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, agent) (rate(contextlens_agent_seconds_bucket[5m])))",
          "legendFormat": "{{agent}}",
          "datasource": {
            "type": "prometheus",
            "uid": "contextlens-prometheus"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Tokens per second",
      "datasource": {
        "type": "prometheus",
        "uid": "contextlens-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (agent) (rate(contextlens_tokens_total[5m]))",
          "legendFormat": "{{agent}}",
          "datasource": {
            "type": "prometheus",
            "uid": "contextlens-prometheus"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Cost (USD per hour)",
      "datasource": {
        "type": "prometheus",
        "uid": "contextlens-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(contextlens_cost_usd_total[1h]))",
          "legendFormat": "cost",
          "datasource": {
            "type": "prometheus",
            "uid": "contextlens-prometheus"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Presses by status",
      "datasource": {
        "type": "prometheus",
        "uid": "contextlens-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(contextlens_presses_total[5m]))",
          "legendFormat": "{{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "contextlens-prometheus"
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Errors by type",
      "datasource": {
        "type": "prometheus",
        "uid": "contextlens-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (error) (rate(contextlens_press_errors_total[5m]))",
          "legendFormat": "{{error}}",
          "datasource": {
            "type": "prometheus",
            "uid": "contextlens-prometheus"
          }
        }
      ]
    }
  ]
}