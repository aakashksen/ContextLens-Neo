{
 "id": "launch",
 "title": "Launch planning (invented)",
 "duration_ms": 82000,
 "turns": [
  {
   "id": "t1",
   "seq": 1,
   "speaker": "Maya",
   "text": "Let’s ship the beta on Friday.",
   "start_ms": 0,
   "end_ms": 4000
  },
  {
   "id": "t2",
   "seq": 2,
   "speaker": "Jordan",
   "text": "Design still owes the onboarding screens.",
   "start_ms": 4500,
   "end_ms": 9000
  },
  {
   "id": "t3",
   "seq": 3,
   "speaker": "Priya",
   "text": "I can have the screens done by Wednesday.",
   "start_ms": 9500,
   "end_ms": 14000
  },
  {
   "id": "t4",
   "seq": 4,
   "speaker": "Jordan",
   "text": "Then QA needs two days, minimum.",
   "start_ms": 14500,
   "end_ms": 19000
  },
  {
   "id": "t5",
   "seq": 5,
   "speaker": "Maya",
   "text": "Okay, then make the beta ship Monday.",
   "start_ms": 19500,
   "end_ms": 23000
  },
  {
   "id": "t6",
   "seq": 6,
   "speaker": "Sam",
   "text": "The budget for the launch video is five thousand dollars.",
   "start_ms": 24000,
   "end_ms": 29000
  },
  {
   "id": "t7",
   "seq": 7,
   "speaker": "Maya",
   "text": "Fine, five thousand is approved.",
   "start_ms": 29500,
   "end_ms": 33000
  },
  {
   "id": "t8",
   "seq": 8,
   "speaker": "Jordan",
   "text": "I’ll send the QA plan tomorrow.",
   "start_ms": 34000,
   "end_ms": 38000
  },
  {
   "id": "t9",
   "seq": 9,
   "speaker": "Priya",
   "text": "Do we announce before or after the beta?",
   "start_ms": 39000,
   "end_ms": 44000
  },
  {
   "id": "t10",
   "seq": 10,
   "speaker": "Maya",
   "text": "After. Priya should see the QA plan before we announce.",
   "start_ms": 44500,
   "end_ms": 49000
  },
  {
   "id": "t11",
   "seq": 11,
   "speaker": "Sam",
   "text": "The video budget has to come down to three thousand.",
   "start_ms": 50000,
   "end_ms": 55000
  },
  {
   "id": "t12",
   "seq": 12,
   "speaker": "Maya",
   "text": "Then I withdraw the five thousand. Make it three.",
   "start_ms": 55500,
   "end_ms": 59000
  },
  {
   "id": "t13",
   "seq": 13,
   "speaker": "Jordan",
   "text": "Who owns the press list?",
   "start_ms": 60000,
   "end_ms": 65000
  },
  {
   "id": "t14",
   "seq": 14,
   "speaker": "Sam",
   "text": "Not me. I thought Priya had it.",
   "start_ms": 65500,
   "end_ms": 70000
  },
  {
   "id": "t15",
   "seq": 15,
   "speaker": "Priya",
   "text": "I don’t. Nobody has taken it.",
   "start_ms": 70500,
   "end_ms": 75000
  },
  {
   "id": "t16",
   "seq": 16,
   "speaker": "Maya",
   "text": "Okay, Sam, take the press list.",
   "start_ms": 75500,
   "end_ms": 80000
  }
 ],
