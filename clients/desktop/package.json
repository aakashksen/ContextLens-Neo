{
  "name": "contextlens-desktop",
  "productName": "ContextLens",
  "version": "0.1.0",
  "private": true,
  "description": "Press a key in a meeting, see what was actually said. Everything stays on this machine.",
  "author": "ContextLens",
  "main": "src/main/main.js",
  "type": "module",
  "scripts": {
    "dev": "electron .",
    "test": "vitest run",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "jsdom": "^26.1.0",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "local.contextlens.desktop",
    "productName": "ContextLens",
    "directories": { "output": "dist", "buildResources": "assets" },
    "files": ["src/**/*", "assets/**/*", "package.json"],
    "win": { "target": ["nsis"], "icon": "assets/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
