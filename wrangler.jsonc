// Cloudflare Worker that serves the website (site/) as static assets at contextlens.aakashsenthilnathan.com.
// One address only: no workers.dev URL and no preview URLs.
{
  "name": "contextlens",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./site" },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "contextlens.aakashsenthilnathan.com", "custom_domain": true }]
}
